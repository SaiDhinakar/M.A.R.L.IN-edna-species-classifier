# Environment Configuration

# Application
APP_NAME=M.A.R.L.IN eDNA Classifier
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database
SQLITE_PATH=./data/app.db
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/edna_vectordb

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-datasets
MINIO_BUCKET_PROCESSED=processed
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_LOGS=logs

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE=3600

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=edna_classification
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ZenML
ZENML_SERVER_URL=http://localhost:8080
ZENML_STORE_TYPE=local
ZENML_ARTIFACT_STORE=./data/zenml_artifacts

# Model Configuration
MODEL_EMBEDDING_DIM=768
MODEL_MAX_SEQ_LENGTH=512
MODEL_CACHE_SIZE=5

# Pipeline Configuration
BATCH_SIZE=32
NUM_CLUSTERS=50
MIN_CLUSTER_SIZE=5

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE=524288000  # 500MB
